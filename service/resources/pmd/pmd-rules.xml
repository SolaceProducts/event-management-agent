<?xml version="1.0"?>
<ruleset name="Custom ruleset">
    <description>
        Event Management agent custom rule set.
    </description>

    <!-- PMD 7 (maven-pmd-plugin 3.28.0): the excludes below keep the pre-upgrade lint
         baseline. They fall into three buckets:

         1. Renames of rules already excluded under PMD 6 - no behavioural change
            (NonExhaustiveSwitch, UnitTest*, TooFewBranchesForSwitch).

         2. Rules introduced by PMD 7, deferred for now (LambdaCanBeMethodReference,
            AvoidSynchronizedStatement, ImplicitFunctionalInterface,
            UnnecessaryWarningSuppression, RelianceOnDefaultCharset,
            TypeParameterNamingConventions, VariableCanBeInlined, UselessPureMethodCall).

         3. Long-standing PMD 6 rules that only started reporting violations here because
            PMD 7's reworked type resolution makes them fire where PMD 6 did not
            (LooseCoupling, BooleanGetMethodName, UnnecessaryFullyQualifiedName,
            SimplifyBooleanReturns, CouplingBetweenObjects, ExcessivePublicCount,
            ExceptionAsFlowControl, ImmutableField, AvoidThrowingNewInstanceOfSameException,
            DataClass). These are pre-existing checks being deferred, not new rules.

         Revisit buckets 2 and 3 separately from the Java 25 upgrade. -->

    <rule ref="category/java/bestpractices.xml">
        <description>
            Rules which enforce generally accepted best practices.
        </description>
        <exclude name="AbstractClassWithoutAbstractMethod"/>
        <exclude name="AvoidReassigningParameters"/>
        <exclude name="DoubleBraceInitialization"/>
        <exclude name="GuardLogStatement"/>
        <exclude name="ImplicitFunctionalInterface"/>
        <exclude name="JUnit5TestShouldBePackagePrivate"/>
        <exclude name="LiteralsFirstInComparisons"/>
        <exclude name="LooseCoupling"/>
        <exclude name="NonExhaustiveSwitch"/>
        <exclude name="PreserveStackTrace"/>
        <exclude name="RelianceOnDefaultCharset"/>
        <exclude name="UnitTestAssertionsShouldIncludeMessage"/>
        <exclude name="UnitTestContainsTooManyAsserts"/>
        <exclude name="UnitTestShouldIncludeAssert"/>
        <exclude name="UnitTestShouldUseBeforeAnnotation"/>
        <exclude name="UnnecessaryWarningSuppression"/>
        <exclude name="UseVarargs"/>
    </rule>

    <rule ref="category/java/codestyle.xml">
        <description>
            Rules which enforce a specific coding style.
        </description>
        <exclude name="AtLeastOneConstructor"/>
        <exclude name="BooleanGetMethodName"/>
        <exclude name="ClassNamingConventions"/>
        <exclude name="CommentDefaultAccessModifier"/>
        <exclude name="ConfusingTernary"/>
        <exclude name="FieldNamingConventions"/>
        <exclude name="FormalParameterNamingConventions"/>
        <exclude name="LambdaCanBeMethodReference"/>
        <exclude name="LinguisticNaming"/>
        <exclude name="LocalVariableCouldBeFinal"/>
        <exclude name="LocalVariableNamingConventions"/>
        <exclude name="LongVariable"/>
        <exclude name="MethodArgumentCouldBeFinal"/>
        <exclude name="MethodNamingConventions"/>
        <exclude name="OnlyOneReturn"/>
        <exclude name="PackageCase"/>
        <exclude name="PrematureDeclaration"/>
        <exclude name="ShortClassName"/>
        <exclude name="ShortVariable"/>
        <exclude name="TooManyStaticImports"/>
        <exclude name="TypeParameterNamingConventions"/>
        <exclude name="UnnecessaryAnnotationValueElement"/>
        <exclude name="UnnecessaryFullyQualifiedName"/>
        <exclude name="UseDiamondOperator"/>
        <exclude name="UselessParentheses"/>
        <exclude name="VariableCanBeInlined"/>
    </rule>

    <rule ref="category/java/design.xml">
        <description>
            Rules that help you discover design issues.
        </description>
        <exclude name="AbstractClassWithoutAnyMethod"/> <!-- consider enabling -->
        <exclude name="AvoidCatchingGenericException"/>
        <exclude name="AvoidDeeplyNestedIfStmts"/>
        <exclude name="AvoidRethrowingException"/>
        <exclude name="AvoidThrowingNewInstanceOfSameException"/>
        <exclude name="AvoidThrowingRawExceptionTypes"/>
        <exclude name="ClassWithOnlyPrivateConstructorsShouldBeFinal"/>
        <exclude name="CollapsibleIfStatements"/>
        <exclude name="CouplingBetweenObjects"/>
        <exclude name="CyclomaticComplexity"/>
        <exclude name="DataClass"/>
        <exclude name="ExceptionAsFlowControl"/>
        <exclude name="ExcessiveImports"/>
        <exclude name="ExcessiveParameterList"/>
        <exclude name="ExcessivePublicCount"/>
        <exclude name="ImmutableField"/>
        <exclude name="LawOfDemeter"/>
        <exclude name="LoosePackageCoupling"/>
        <exclude name="NPathComplexity"/>
        <exclude name="SignatureDeclareThrowsException"/>
        <exclude name="SimplifyBooleanReturns"/>
        <exclude name="TooManyFields"/>
        <exclude name="TooManyMethods"/>
        <exclude name="UseObjectForClearerAPI"/>
        <exclude name="UseUtilityClass"/>
    </rule>

    <rule ref="category/java/errorprone.xml">
        <description>
            Rules to detect constructs that are either broken, extremely confusing or prone to runtime errors.
        </description>
        <exclude name="AssignmentInOperand"/> <!-- re-added below, configured -->
        <exclude name="AvoidCatchingThrowable"/>
        <exclude name="AvoidDuplicateLiterals"/>
        <exclude name="AvoidFieldNameMatchingMethodName"/>
        <exclude name="AvoidLiteralsInIfCondition"/>
        <exclude name="AvoidUsingOctalValues"/>
        <exclude name="DetachedTestCase"/>
        <exclude name="EmptyCatchBlock"/>
        <exclude name="MissingSerialVersionUID"/>
        <exclude name="TestClassWithoutTestCases"/>
        <exclude name="UseLocaleWithCaseConversions"/>
        <exclude name="UselessPureMethodCall"/>
    </rule>

    <!-- AssignmentInOperand is enforced, but the canonical read loop
         "while ((line = reader.readLine()) != null)" is idiomatic Java, not a defect,
         so only assignments in if/return/ternary operands are reported. -->
    <rule ref="category/java/errorprone.xml/AssignmentInOperand">
        <properties>
            <property name="allowWhile" value="true"/>
        </properties>
    </rule>

    <rule ref="category/java/multithreading.xml">
        <description>
            Rules that flag issues when dealing with multiple threads of execution.
        </description>
        <exclude name="AvoidSynchronizedStatement"/>
        <exclude name="AvoidUsingVolatile"/>
        <exclude name="DoNotUseThreads"/>
        <exclude name="UseConcurrentHashMap"/>
    </rule>

    <rule ref="category/java/performance.xml">
        <description>
            Rules that flag suboptimal code.
        </description>
        <exclude name="AvoidInstantiatingObjectsInLoops"/>
        <exclude name="ConsecutiveAppendsShouldReuse"/>
        <exclude name="ConsecutiveLiteralAppends"/>
        <exclude name="InsufficientStringBufferDeclaration"/>
        <exclude name="TooFewBranchesForSwitch"/>
        <exclude name="UseStringBufferForStringAppends"/>
    </rule>

</ruleset>
